{
  "id": "2ab20dbb-eda9-438b-9722-e10fa12ad907",
  "name": "终端完整配置示例",
  "namespace": "terminal_full_example",
  "description": "演示各种参数和终端配置：文本、数字、选项、布尔值、列表、对象、默认值及固定值。运行时输出配置摘要和示例内容。",
  "version": 1,
  "source": "ui",
  "status": "draft",
  "enabled": false,
  "runner": {
    "type": "terminal",
    "settings": {
      "type": "terminal",
      "command": "printf '任务：%s\\n' \"$NAME\"\nprintf '工作目录：%s\\n' \"$PWD\"\nprintf '正在输出 %s 行内容…\\n\\n' \"$COUNT\"\nif [ \"$SHOW_DETAILS\" = true ]; then\n  printf '输出格式：%s\\n间隔：%s 秒\\n标签：%s\\n附加配置：%s\\n' \"$FORMAT\" \"$INTERVAL\" \"$TAGS\" \"$OPTIONS\"\n  [ -z \"$NOTE\" ] || printf '备注：%s\\n' \"$NOTE\"\n  [ -z \"$FIXED_LABEL\" ] || printf '固定标识：已配置\\n'\n  [ -z \"$LUMI_EXAMPLE_PROFILE\" ] || printf '环境变量：已配置\\n'\n  printf '\\n'\nfi\nlumi_example_index=1\nwhile [ \"$lumi_example_index\" -le \"$COUNT\" ]; do\n  if [ \"$FORMAT\" = '彩色文字' ]; then\n    printf '\\033[32m[%s/%s] %s\\033[0m\\n' \"$lumi_example_index\" \"$COUNT\" \"$TEXT\"\n  else\n    printf '[%s/%s] %s\\n' \"$lumi_example_index\" \"$COUNT\" \"$TEXT\"\n  fi\n  sleep \"$INTERVAL\"\n  lumi_example_index=$((lumi_example_index + 1))\ndone\nprintf '\\n执行完成。\\n'\n",
      "cwd": "/tmp",
      "shell": "/bin/zsh",
      "environment": {
        "LUMI_EXAMPLE_PROFILE": "complete-demo"
      }
    }
  },
  "tools": [
    {
      "name": "run",
      "description": "运行完整配置示例",
      "fields": [
        {
          "key": "NAME",
          "schema": {
            "type": "string",
            "title": "任务名称",
            "description": "给这次运行起个名字。",
            "minLength": 1,
            "maxLength": 80
          },
          "required": true,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "NAME"
          }
        },
        {
          "key": "TEXT",
          "schema": {
            "type": "string",
            "title": "显示内容",
            "description": "会原样打印到运行内容中。",
            "maxLength": 500,
            "default": "你好，Lumi"
          },
          "required": true,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "TEXT"
          }
        },
        {
          "key": "COUNT",
          "schema": {
            "type": "integer",
            "title": "显示次数",
            "description": "控制输出行数，范围 1–20。",
            "minimum": 1,
            "maximum": 20,
            "default": 3
          },
          "required": true,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "COUNT"
          }
        },
        {
          "key": "INTERVAL",
          "schema": {
            "type": "number",
            "title": "每行间隔（秒）",
            "description": "控制每一行输出之间的等待时间。",
            "minimum": 0,
            "maximum": 1.5,
            "default": 0.05
          },
          "required": false,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "INTERVAL"
          }
        },
        {
          "key": "FORMAT",
          "schema": {
            "type": "string",
            "title": "输出格式",
            "description": "普通文字或带颜色的文字。",
            "enum": [
              "普通文字",
              "彩色文字"
            ],
            "default": "普通文字"
          },
          "required": false,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "FORMAT"
          }
        },
        {
          "key": "SHOW_DETAILS",
          "schema": {
            "type": "boolean",
            "title": "显示配置摘要",
            "description": "开启后在输出中展示公开配置。",
            "default": true
          },
          "required": false,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "SHOW_DETAILS"
          }
        },
        {
          "key": "TAGS",
          "schema": {
            "type": "array",
            "title": "标签列表",
            "description": "填写 JSON 列表，例如 [\"演示\", \"界面检查\"]。",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "default": [
              "演示",
              "界面检查"
            ]
          },
          "required": false,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "TAGS"
          }
        },
        {
          "key": "OPTIONS",
          "schema": {
            "type": "object",
            "title": "附加配置",
            "description": "填写 JSON 对象；用于查看结构化参数的显示和传递。",
            "properties": {
              "language": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "default": {
              "language": "zh-CN",
              "note": "完整配置示例"
            }
          },
          "required": false,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "OPTIONS"
          }
        },
        {
          "key": "NOTE",
          "schema": {
            "type": "string",
            "title": "备注",
            "description": "可留空，用于检查可选参数。",
            "maxLength": 200
          },
          "required": false,
          "aiVisible": true,
          "value": null,
          "binding": {
            "location": "argument",
            "key": "NOTE"
          }
        },
        {
          "key": "FIXED_LABEL",
          "schema": {
            "type": "string",
            "title": "固定标识",
            "description": "工具保存的内部固定值，不提交给 AI。"
          },
          "required": false,
          "aiVisible": false,
          "value": "lumi-demo-fixed",
          "binding": {
            "location": "argument",
            "key": "FIXED_LABEL"
          }
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "createdAt": "2026-10-11T03:13:31.282624+00:00",
  "updatedAt": "2026-10-11T03:13:31.282624+00:00"
}
