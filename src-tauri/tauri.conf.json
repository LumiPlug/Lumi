{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumi",
  "version": "0.1.0",
  "identifier": "com.lumiplug.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:sidecars:dev && pnpm exec vite --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "pnpm build:frontend && pnpm build:sidecars",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumi",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "width": 1120,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MPL-2.0",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lumi-core", "binaries/mcp-stdio-proxy"],
    "resources": ["../dist/sidecars/THIRD_PARTY_NOTICES.txt", "../LICENSE", "../docs/LICENSING.md"]
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
